<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Boundary.Login.LoginPage">
  <grid id="fe17f" binding="pane" layout-manager="GridLayoutManager" row-count="9" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="50" left="50" bottom="50" right="50"/>
    <constraints>
      <xy x="20" y="20" width="1920" height="1080"/>
    </constraints>
    <properties>
      <foreground color="-15788246"/>
      <minimumSize width="500" height="300"/>
      <preferredSize width="920" height="720"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="43031" class="javax.swing.JLabel" binding="emailLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Email"/>
        </properties>
      </component>
      <vspacer id="4fb84">
        <constraints>
          <grid row="8" column="0" row-span="1" col-span="3" vsize-policy="4" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <component id="d8ae8" class="javax.swing.JTextField" binding="textField1" default-binding="true">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="6" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="300" height="-1"/>
          </grid>
        </constraints>
        <properties/>
      </component>
      <component id="57a10" class="javax.swing.JLabel" binding="passwordLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="2" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Password"/>
        </properties>
      </component>
      <vspacer id="54e0b">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="1" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="300" height="-1"/>
            <preferred-size width="400" height="-1"/>
            <maximum-size width="500" height="-1"/>
          </grid>
        </constraints>
      </vspacer>
      <component id="79af8" class="javax.swing.JButton" binding="signInButton" default-binding="true">
        <constraints>
          <grid row="6" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="100" height="20"/>
            <preferred-size width="100" height="30"/>
            <maximum-size width="100" height="20"/>
          </grid>
        </constraints>
        <properties>
          <actionCommand value="clickOnLogin"/>
          <selected value="false"/>
          <text value="Sign in"/>
          <visible value="true"/>
        </properties>
      </component>
      <component id="7e816" class="javax.swing.JLabel" binding="labelImmagine" custom-create="true">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="3" vsize-policy="4" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value=""/>
        </properties>
      </component>
      <component id="4f157" class="javax.swing.JButton" binding="nonHaiUnAccountButton" default-binding="true">
        <constraints>
          <grid row="7" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <minimum-size width="200" height="30"/>
            <preferred-size width="200" height="30"/>
            <maximum-size width="200" height="30"/>
          </grid>
        </constraints>
        <properties>
          <borderPainted value="false"/>
          <contentAreaFilled value="false"/>
          <foreground color="-16749351"/>
          <text value="Non hai un account? Registrati"/>
        </properties>
        <clientProperties>
          <hideActionText class="java.lang.Boolean" value="false"/>
        </clientProperties>
      </component>
      <grid id="4adee" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
            <minimum-size width="200" height="40"/>
            <preferred-size width="300" height="40"/>
            <maximum-size width="300" height="40"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="1423d" class="javax.swing.JPasswordField" binding="passwordField1" default-binding="true">
            <constraints border-constraint="Center"/>
            <properties>
              <maximumSize width="100" height="200"/>
              <text value=""/>
            </properties>
            <clientProperties>
              <JPasswordField.cutCopyAllowed class="java.lang.Boolean" value="false"/>
            </clientProperties>
          </component>
          <component id="acaa2" class="javax.swing.JButton" binding="showButton" default-binding="true">
            <constraints border-constraint="East"/>
            <properties>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
