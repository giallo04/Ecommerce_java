<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Boundary.ClientView.Catalogo.ProductDetail">
  <grid id="cbd77" binding="contentPane" layout-manager="GridLayoutManager" row-count="6" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="16" vgap="16">
    <margin top="20" left="20" bottom="20" right="20"/>
    <constraints>
      <xy x="48" y="54" width="750" height="700"/>
